# Get this from https://console.anthropic.com (API Keys section)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Check https://docs.claude.com for the current model ID string to use here.
ANTHROPIC_MODEL=claude-sonnet-5

# Temporary local preview only. Set to true to see the scoring and upgrade UI without an AI key.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# From your Gumroad product's URL, e.g. gumroad.com/l/abc123 -> the "abc123" part
# Find it in Gumroad dashboard -> your product -> Share (it's the permalink)
GUMROAD_PRODUCT_PERMALINK=your-product-permalink
